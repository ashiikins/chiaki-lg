+	chiaki_mutex_lock(&takion->gkcrypt_local_mutex);
+	uint32_t counter = takion->ext_counter_local++;
+	chiaki_mutex_unlock(&takion->gkcrypt_local_mutex);
+	chiaki_takion_format_ext_header(buf, timestamp, counter);
