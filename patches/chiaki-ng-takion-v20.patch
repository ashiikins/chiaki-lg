new file mode 100644
index 00000000..a5d63981
--- /dev/null
+++ b/lib/src/takionversion.c
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include <chiaki/takionversion.h>
+#include <chiaki/ecdh.h>
+
+#include <takion.pb.h>
+#include <pb_encode.h>
+
+#include "pb_utils.h"
+
+#include <string.h>
+
+CHIAKI_EXPORT uint32_t chiaki_takion_version_features(uint8_t version)
+{
+	switch(version)
+	{
+		case 9:
+			return 0x1f;
+		case 10:
+			return 0x2f;
+		case 11:
+			return 0x5f;
+		case 12:
+			return 0xdf;
+		case 13:
+		case 14:
+			return 0xff;
+		case 15:
+		case 16:
+		case 17:
+			return 0x1fff;
+		case 18:
+			return 0xffff;
+		case 19:
+			return 0x1ffff;
+		case 20:
+			return 0x7ffff;
+		default:
+			return 0;
+	}
+}
+
+CHIAKI_EXPORT ChiakiECDHCurve chiaki_takion_version_ecdh_curve(uint8_t version)
+{
+	return chiaki_takion_version_has_feature(version, CHIAKI_TAKION_FEATURE_P521_ECDH)
+		? CHIAKI_ECDH_CURVE_SECP521R1
+		: CHIAKI_ECDH_CURVE_SECP256K1;
+}
+
+CHIAKI_EXPORT bool chiaki_takion_version_is_selectable(uint8_t version)
+{
+	return version == CHIAKI_TAKION_VERSION_PS5_LEGACY
+		|| version == CHIAKI_TAKION_VERSION_PS5_V15
+		|| version == CHIAKI_TAKION_VERSION_PS5;
+}
+
+CHIAKI_EXPORT uint8_t chiaki_takion_version_first(bool ps5, uint8_t pinned)
+{
+	if(!ps5)
+		return CHIAKI_TAKION_VERSION_PS4;
+	return pinned ? pinned : CHIAKI_TAKION_VERSION_PS5;
+}
+
+CHIAKI_EXPORT uint8_t chiaki_takion_version_fallback(bool ps5, uint8_t pinned, uint8_t failed)
+{
+	if(!ps5 || pinned)
+		return 0;
+	return failed == CHIAKI_TAKION_VERSION_PS5 ? CHIAKI_TAKION_VERSION_PS5_LEGACY : 0;
+}
+
+static void store_le16(uint8_t *buf, uint16_t v)
+{
+	buf[0] = v & 0xff;
+	buf[1] = v >> 8;
+}
+
+static void store_le32(uint8_t *buf, uint32_t v)
+{
+	store_le16(buf, v & 0xffff);
+	store_le16(buf + 2, v >> 16);
+}
+
+CHIAKI_EXPORT void chiaki_audio_state_full_layout(uint8_t out[CHIAKI_AUDIO_STATE_FULL_SIZE])
+{
+	static const int16_t positions[8][2] = {
+		{ 30, 0 }, { -30, 0 }, { 0, 0 }, { -360, -360 },
+		{ 90, 0 }, { -90, 0 }, { 135, 0 }, { -135, 0 }
+	};
+	memset(out, 0, CHIAKI_AUDIO_STATE_FULL_SIZE);
+	out[0] = 3;
+	store_le32(out + 1, 0xff);
+	store_le32(out + 5, 1);
+	for(size_t i = 0; i < 8; i++)
+	{
+		store_le16(out + 9 + i * 4, (uint16_t)positions[i][0]);
+		store_le16(out + 9 + i * 4 + 2, (uint16_t)positions[i][1]);
+	}
+}
+
+CHIAKI_EXPORT void chiaki_audio_state_port_states(uint8_t out[CHIAKI_AUDIO_STATE_PORT_STATES_SIZE], ChiakiAudioPortGroup group, size_t slot, ChiakiAudioPortOutput output, int16_t volume)
+{
+	memset(out, 0, CHIAKI_AUDIO_STATE_PORT_STATES_SIZE);
+	out[0] = (uint8_t)group;
+	if(slot >= CHIAKI_AUDIO_STATE_PORT_SLOTS)
+		return;
+	store_le16(out + 1 + slot * 2, (uint16_t)output);
+	store_le16(out + 1 + CHIAKI_AUDIO_STATE_PORT_SLOTS * 2 + slot * 2, (uint16_t)volume);
+}
+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_audio_state_encode(ChiakiAudioStateType type, const uint8_t *data, size_t data_size, uint8_t *buf, size_t *buf_size)
+{
+	ChiakiPBBuf data_buf = { data_size, (uint8_t *)data };
+
+	tkproto_TakionMessage msg;
+	memset(&msg, 0, sizeof(msg));
+	msg.type = tkproto_TakionMessage_PayloadType_AUDIOSTATE;
+	msg.has_audio_state = true;
+	msg.audio_state.audio_state_type = (tkproto_AudioStatePayload_AudioStateType)type;
+	if(data)
+	{
+		msg.audio_state.audio_state_data.arg = &data_buf;
+		msg.audio_state.audio_state_data.funcs.encode = chiaki_pb_encode_buf;
+	}
+
+	pb_ostream_t stream = pb_ostream_from_buffer(buf, *buf_size);
+	if(!pb_encode(&stream, tkproto_TakionMessage_fields, &msg))
+		return CHIAKI_ERR_BUF_TOO_SMALL;
+	*buf_size = stream.bytes_written;
+	return CHIAKI_ERR_SUCCESS;
+}
