+static ChiakiErrorCode stream_connection_send_audio_state(ChiakiStreamConnection *stream_connection, ChiakiAudioStateType type, const uint8_t *data, size_t data_size)
+{
+	uint8_t buf[CHIAKI_AUDIO_STATE_MESSAGE_SIZE_MAX];
+	size_t buf_size = sizeof(buf);
+	ChiakiErrorCode err = chiaki_audio_state_encode(type, data, data_size, buf, &buf_size);
+	if(err != CHIAKI_ERR_SUCCESS)
+	{
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection audio state protobuf encoding failed");
+		return err;
+	}
+	return chiaki_takion_send_message_data(&stream_connection->takion, 1, 1, buf, buf_size, NULL);
