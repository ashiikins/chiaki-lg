index 00000000..9411cc13
--- /dev/null
+++ b/lib/include/chiaki/takionversion.h
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#ifndef CHIAKI_TAKIONVERSION_H
+#define CHIAKI_TAKIONVERSION_H
+
+#include "common.h"
+#include "ecdh.h"
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CHIAKI_TAKION_VERSION_PS4 9
+#define CHIAKI_TAKION_VERSION_PS5_LEGACY 12
+#define CHIAKI_TAKION_VERSION_PS5_V15 15
+#define CHIAKI_TAKION_VERSION_PS5 20
+
+/**
+ * Bit numbers of the feature mask of a Takion version
+ */
+typedef enum chiaki_takion_feature_t
+{
+	CHIAKI_TAKION_FEATURE_P521_ECDH = 5,
+	CHIAKI_TAKION_FEATURE_GENERIC_CONTROL_DATA = 8,
+	CHIAKI_TAKION_FEATURE_AUTOMATIC_DYNAMIC_RANGE = 9,
+	CHIAKI_TAKION_FEATURE_AUDIO_PROFILES = 10,
+	CHIAKI_TAKION_FEATURE_AUDIO_UNIT_COUNT_ONLY = 11,
+	CHIAKI_TAKION_FEATURE_RENDER_METRICS = 12,
+	CHIAKI_TAKION_FEATURE_EXTENDED_MESSAGES = 13,
+	CHIAKI_TAKION_FEATURE_AUDIO_CHANNEL_COUNT_STATE = 15,
+	CHIAKI_TAKION_FEATURE_WIDE_AUDIO_AVAILABLE_BITS = 16,
+	CHIAKI_TAKION_FEATURE_EXTENDED_PACKET_HEADERS = 17
+} ChiakiTakionFeature;
+
+/**
+ * @return the feature mask a Takion version has, 0 for unknown versions
+ */
+CHIAKI_EXPORT uint32_t chiaki_takion_version_features(uint8_t version);
+
+static inline bool chiaki_takion_version_has_feature(uint8_t version, ChiakiTakionFeature feature)
+{
+	return (chiaki_takion_version_features(version) >> feature) & 1;
+}
+
+CHIAKI_EXPORT ChiakiECDHCurve chiaki_takion_version_ecdh_curve(uint8_t version);
+
+/**
+ * @return whether version can be set as ChiakiConnectInfo.takion_version
+ */
+CHIAKI_EXPORT bool chiaki_takion_version_is_selectable(uint8_t version);
+
+/**
+ * @param pinned ChiakiConnectInfo.takion_version
+ * @return the version to try first
+ */
+CHIAKI_EXPORT uint8_t chiaki_takion_version_first(bool ps5, uint8_t pinned);
+
+/**
+ * @param failed the version whose handshake just failed
+ * @return the version to try next, 0 if there is none
+ */
+CHIAKI_EXPORT uint8_t chiaki_takion_version_fallback(bool ps5, uint8_t pinned, uint8_t failed);
+
+#define CHIAKI_AUDIO_LANE_MAIN 0
+#define CHIAKI_AUDIO_LANE_VOICE 1
+#define CHIAKI_AUDIO_LANE_HAPTICS_FIRST 2
+#define CHIAKI_AUDIO_LANE_CONTROLLER_SPEAKER_FIRST 6
+
+#define CHIAKI_AUDIO_STATE_FULL_SIZE 73
+#define CHIAKI_AUDIO_STATE_PORT_STATES_SIZE 33
+#define CHIAKI_AUDIO_STATE_PORT_SLOTS 4
+#define CHIAKI_AUDIO_STATE_MESSAGE_SIZE_MAX 96
+
+typedef enum chiaki_audio_state_type_t
+{
+	CHIAKI_AUDIO_STATE_TYPE_FULL = 0,
+	CHIAKI_AUDIO_STATE_TYPE_FLAGS = 1,
+	CHIAKI_AUDIO_STATE_TYPE_ANGLE = 2,
+	CHIAKI_AUDIO_STATE_TYPE_HRTF = 3,
+	CHIAKI_AUDIO_STATE_TYPE_TV_CONFIG = 4,
+	CHIAKI_AUDIO_STATE_TYPE_PORT_STATES = 5,
+	CHIAKI_AUDIO_STATE_TYPE_CHANNEL_COUNT = 6
+} ChiakiAudioStateType;
+
+typedef enum chiaki_audio_port_group_t
+{
+	CHIAKI_AUDIO_PORT_GROUP_CONTROLLER = 0,
+	CHIAKI_AUDIO_PORT_GROUP_MAIN = 1
+} ChiakiAudioPortGroup;
+
+typedef enum chiaki_audio_port_output_t
+{
+	CHIAKI_AUDIO_PORT_OUTPUT_NONE = 0x0000,
+	CHIAKI_AUDIO_PORT_OUTPUT_MAIN = 0x0001,
+	CHIAKI_AUDIO_PORT_OUTPUT_CONTROLLER_SPEAKER = 0x0004
+} ChiakiAudioPortOutput;
+
+#define CHIAKI_AUDIO_PORT_FULL_VOLUME 127
+
+/**
+ * Body of a FULL audio state describing a 7.1 speaker layout
+ */
+CHIAKI_EXPORT void chiaki_audio_state_full_layout(uint8_t out[CHIAKI_AUDIO_STATE_FULL_SIZE]);
+
+/**
+ * Body of a PORTSTATES audio state routing one slot. Slots >= CHIAKI_AUDIO_STATE_PORT_SLOTS leave every port unset.
+ */
+CHIAKI_EXPORT void chiaki_audio_state_port_states(uint8_t out[CHIAKI_AUDIO_STATE_PORT_STATES_SIZE], ChiakiAudioPortGroup group, size_t slot, ChiakiAudioPortOutput output, int16_t volume);
+
+/**
+ * Encode a TakionMessage of type AUDIOSTATE
+ * @param data may be NULL for no audio_state_data
+ * @param buf_size in: size of buf, out: bytes written
+ */
+CHIAKI_EXPORT ChiakiErrorCode chiaki_audio_state_encode(ChiakiAudioStateType type, const uint8_t *data, size_t data_size, uint8_t *buf, size_t *buf_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // CHIAKI_TAKIONVERSION_H
