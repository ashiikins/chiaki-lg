+
+CHIAKI_EXPORT ChiakiErrorCode chiaki_stream_connection_run(ChiakiStreamConnection *stream_connection, chiaki_socket_t *socket)
+{
+	ChiakiSession *session = stream_connection->session;
+	bool ps5 = chiaki_target_is_ps5(session->target);
+	uint8_t pinned = session->connect_info.takion_version;
+	uint8_t version = chiaki_takion_version_first(ps5, pinned);
+	ChiakiErrorCode err;
+
+	while(true)
+	{
+		uint8_t fallback = chiaki_takion_version_fallback(ps5, pinned, version);
+		bool close_socket = !socket || !fallback;
+		bool takion_started = false;
+
+		err = chiaki_ecdh_init_curve(&session->ecdh, chiaki_takion_version_ecdh_curve(version));
+		if(err != CHIAKI_ERR_SUCCESS)
+		{
+			CHIAKI_LOGE(session->log, "Session failed to initialize ECDH");
+			err = CHIAKI_ERR_UNKNOWN;
+			break;
+		}
+		stream_connection->handshake_done = false;
+		err = stream_connection_run_attempt(stream_connection, socket, version, close_socket, &takion_started);
+		chiaki_ecdh_fini(&session->ecdh);
+
+		bool retry = fallback && (!socket || takion_started) && !stream_connection->handshake_done && err != CHIAKI_ERR_CANCELED && !stream_connection->should_stop;
+		if(socket && !close_socket && takion_started && !retry)
+			CHIAKI_SOCKET_CLOSE(*socket);
+		if(!retry)
+			break;
+
+		CHIAKI_LOGW(session->log, "StreamConnection handshake with Takion version %u failed, retrying with version %u", (unsigned int)version, (unsigned int)fallback);
+		stream_connection_reset_for_retry(stream_connection);
+		version = fallback;
+	}
+	return err;
+}
