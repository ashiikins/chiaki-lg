+static void stream_connection_send_audio_ports(ChiakiStreamConnection *stream_connection)
+{
+	uint8_t body[CHIAKI_AUDIO_STATE_PORT_STATES_SIZE];
+	ChiakiErrorCode err;
+	if(stream_connection->session->controller_speaker_sink.frame_cb)
+	{
+		chiaki_audio_state_port_states(body, CHIAKI_AUDIO_PORT_GROUP_CONTROLLER, 0, CHIAKI_AUDIO_PORT_OUTPUT_CONTROLLER_SPEAKER, CHIAKI_AUDIO_PORT_FULL_VOLUME);
+		err = stream_connection_send_audio_state(stream_connection, CHIAKI_AUDIO_STATE_TYPE_PORT_STATES, body, sizeof(body));
+		if(err != CHIAKI_ERR_SUCCESS)
+			CHIAKI_LOGE(stream_connection->log, "StreamConnection failed to send controller speaker audio route");
+	}
+	chiaki_audio_state_port_states(body, CHIAKI_AUDIO_PORT_GROUP_MAIN, 0, CHIAKI_AUDIO_PORT_OUTPUT_MAIN, CHIAKI_AUDIO_PORT_FULL_VOLUME);
+	err = stream_connection_send_audio_state(stream_connection, CHIAKI_AUDIO_STATE_TYPE_PORT_STATES, body, sizeof(body));
+	if(err != CHIAKI_ERR_SUCCESS)
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection failed to send main audio route");
+}
+
+static void stream_connection_send_audio_state_start(ChiakiStreamConnection *stream_connection)
+{
+	if(!chiaki_takion_version_has_feature(stream_connection->takion.version, CHIAKI_TAKION_FEATURE_AUDIO_PROFILES))
+		return;
+	uint8_t body[CHIAKI_AUDIO_STATE_FULL_SIZE];
+	chiaki_audio_state_full_layout(body);
+	ChiakiErrorCode err = stream_connection_send_audio_state(stream_connection, CHIAKI_AUDIO_STATE_TYPE_FULL, body, sizeof(body));
+	if(err != CHIAKI_ERR_SUCCESS)
+		CHIAKI_LOGE(stream_connection->log, "StreamConnection failed to send audio layout");
+	stream_connection_send_audio_ports(stream_connection);
+	stream_connection->audio_state_repeats = AUDIO_STATE_REPEAT_COUNT;
+}
